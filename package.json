{
  "name": "gradexis",
  "private": true,
  "version": "1.0.0",
  "description": "Gradexis",
  "repository": "",
  "license": "UNLICENSED",
  "scripts": {
    "api": "cd gradexis-api && nodemon index.js",
    "start": "npm run dev",
    "dev": "cross-env NODE_ENV=development vite",
    "all": "concurrently \"npm run dev\" \"npm run api\"",
    "build": "cross-env NODE_ENV=production vite build && npx cap sync",
    "postinstall": "cpy --flat ./node_modules/framework7-icons/fonts/*.* ./src/fonts/ && cpy --flat ./node_modules/material-icons/iconfont/*.* ./src/fonts/",
    "android": "npm run build && npx cap sync android && npx cap run android",
    "android:build": "npm run build && npx cap sync android"
  },
  "browserslist": [
    "IOS >= 15",
    "Safari >= 15",
    "last 5 Chrome versions",
    "last 5 Firefox versions"
  ],
  "dependencies": {
    "@aashu-dubey/capacitor-statusbar-safe-area": "^4.0.0",
    "@aparajita/capacitor-biometric-auth": "^9.1.2",
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.1",
    "@capacitor/camera": "^7.0.3",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "@capacitor/local-notifications": "^7.0.4",
    "@capacitor/preferences": "^7.0.3",
    "@capacitor/push-notifications": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.4",
    "@capacitor/status-bar": "^7.0.4",
    "@capgo/inappbrowser": "^7.29.4",
    "@material/material-color-utilities": "^0.3.0",
    "axios": "^1.13.2",
    "axios-cookiejar-support": "^6.0.5",
    "chart.js": "^4.5.1",
    "cheerio": "^1.1.2",
    "color-convert": "^3.1.3",
    "cors": "^2.8.5",
    "dom7": "^4.0.6",
    "express": "^5.2.1",
    "framework7": "^8.3.4",
    "framework7-icons": "^5.0.5",
    "framework7-react": "^8.3.4",
    "material-icons": "^1.13.14",
    "prop-types": "^15.8.1",
    "react": "^19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.3",
    "skeleton-elements": "^4.0.1",
    "swiper": "^11.2.10",
    "tough-cookie": "^5.1.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^9.39.2",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "cpy-cli": "^5.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "postcss-preset-env": "^10.5.0",
    "vite": "^6.4.1",
    "vite-plugin-terminal": "^1.3.0"
  }
}
